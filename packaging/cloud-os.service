[Unit]
Description=Cloud Security Lab OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudos
Group=cloudos
Environment=CLOUD_OS_HOME=/var/lib/cloud-os
Environment=CLOUD_OS_SOURCE=/opt/cloud-security-lab-os
WorkingDirectory=/opt/cloud-security-lab-os
ExecStart=/opt/cloud-security-lab-os/.venv/bin/cloud-os start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloud-os

[Install]
WantedBy=multi-user.target
